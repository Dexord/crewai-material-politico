# Ollama rodando localmente na mesma máquina
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Diretório de saída
OUTPUT_DIR=data/output

# Máximo de requisições por segundo no scraping
SCRAPE_RATE_LIMIT=1.5

# Vault (grafo de conhecimento estilo Obsidian)
VAULT_DIR=data/vault

# Profundidade máxima da expansão recursiva da fila de pesquisa
MAX_DEPTH=2
