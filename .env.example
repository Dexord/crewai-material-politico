# Ollama rodando localmente na mesma máquina
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Modelo para os agentes de escrita/analise (deixe igual ao de cima se quiser um modelo so)
OLLAMA_MODEL_ESCRITA=gemma4:e4b

# Diretório de saída
OUTPUT_DIR=data/output

# Estado (filas JSON: pesquisa, pautas, postagem, material)
ESTADO_DIR=data/estado

# Re-pesquisa: dias para considerar um alvo "velho" e elegível a revisita
FRESCOR_DIAS=4
# Revisita híbrida: top-N por centralidade + M aleatórios
REVISITAR_TOP=10
REVISITAR_ALEATORIO=3

# Dedupe de fatos: similaridade (Jaccard de tokens) a partir da qual o fato é
# fundido no existente (acumulando as fontes)
DEDUPE_FATOS_LIMIAR=0.85

# Máximo de requisições por segundo no scraping
SCRAPE_RATE_LIMIT=1.5

# Vault (grafo de conhecimento estilo Obsidian)
VAULT_DIR=data/vault

# Profundidade máxima da expansão recursiva da fila de pesquisa
MAX_DEPTH=3

# Alvos que NÃO devem ser auto-enfileirados (separados por vírgula). Vazio = nenhum.
BLACKLIST_ALVOS=
